      "role": "assistant",
      "content": "",
      "tool_calls": [
        {
          "function": {
            "name": "db_query",
            "arguments": {
              "sql": "SELECT * FROM failed_jobs",
              "target": "primary"
            }
          }
        },
        {
          "function": {
