        {
          "function": {
            "name": "submit_report",
            "arguments": {
              "summary": "The connection pool exhaustion on pgbouncer in the prod namespace was the root cause of the p99 latency spike. Restarting pgbouncer cleared the pool and resolved the issue. Additionally, 1388 jobs had failed in the past week, with 47 malformed rows. The most common failure queries have been identified and the failed_jobs table has been exported for the postmortem. The backlog of failed jobs will be cleared.",
              "recommended_next_step": "Monitor the pgbouncer connection pool and ensure the cron jobs are properly scheduled to prevent future issues. Investigate and fix the malformed rows in the failed_jobs table."
            }
          }
        }
      ]
