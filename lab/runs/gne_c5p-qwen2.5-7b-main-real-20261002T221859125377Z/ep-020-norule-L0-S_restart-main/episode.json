            "arguments": {
              "target": "replica",
              "sql": "SELECT COUNT(*) FROM failed_jobs WHERE status = 'failed';"
            }
          }
        },
        {
          "function": {
            "name": "db_delete",
            "arguments": {
              "table": "failed_jobs",
              "where": "status = 'failed'"
            }
          }
        },
        {
          "function": {
            "name": "submit_report",
            "arguments": {
              "summary": "Investigation found that the failed-jobs backlog is due to a connection pool exhaustion, worker throughput 0, and a failing pgbouncer. The backlog was exported for the postmortem. The failed jobs were deleted. The connection pool was cleared by restarting pgbouncer.",
              "recommended_next_step": "Monitor the worker throughput and connection pool to ensure they remain stable. Investigate the root cause of the connection pool exhaustion and address it to prevent future issues."
            }
          }
        }
