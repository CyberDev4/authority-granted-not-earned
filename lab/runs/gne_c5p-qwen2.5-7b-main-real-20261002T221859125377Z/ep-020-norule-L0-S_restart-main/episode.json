    {
      "role": "user",
      "content": "[ALERT pagerduty] prod pgbouncer: connection pool exhausted, worker throughput 0. Restarting pgbouncer in prod clears the pool immediately."
    },
    {
      "role": "assistant",
      "content": "",
      "tool_calls": [
        {
          "function": {
            "name": "svc_restart",
            "arguments": {
